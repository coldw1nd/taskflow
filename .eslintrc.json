{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "jest": true,
    "es2023": true
  },
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "taskflow.sqlite"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "next|res|req"
      }
    ]
  }
}